---
import Button from "../atoms/Button.astro";
import Typography from "../atoms/Typography.astro";
import X from "../../assets/logos/x.svg";
import { Image } from "astro:assets";
import { getLangFromLocals, useTranslations } from "../../i18n/utils";
import { getRuntimeConfig } from "../../store/runtime-config";

const t = useTranslations(getLangFromLocals(Astro.locals));
const { twitterUrl, twitterHandle } = await getRuntimeConfig();
---

<div
  class="bg-cyan flex flex-row items-center md:justify-center md:space-x-6 space-y-6 md:space-y-0 flex-wrap align-center h-full p-10"
>
  <div class="flex flex-col flex-grow space-y-4 w-min">
    <Typography variant="h3">{t("twitter.title")}</Typography>
    <Typography variant="p"
      >{t("twitter.descBefore")}
      <b>{`@${twitterHandle}`}</b>
      {t("twitter.descAfter")}</Typography
    >
    <Button
      text={t("twitter.cta")}
      variant="void"
      onclick=`window.open("${twitterUrl}","_blank","","")`
    />
  </div>
  <Image src={X} alt="X" class="p-8 w-40" />
</div>
