---
import { Image } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/atoms/Footer.astro";
import BackTop from "../components/atoms/BackTop.astro";
import Typography from "../components/atoms/Typography.astro";
import SensorImage from "../assets/sensor.png";
import { PARAGUAY_DEPARTMENTS } from "../data/departments";
import {
  GLYPHS,
  INSTITUTION_TYPE_OPTIONS,
  PRICE_STEPS,
  SEGMENTS,
  SERVICE_ITEMS,
} from "../data/leasing";
import { getRuntimeConfig } from "../store/runtime-config";
import { getLangFromLocals, useTranslations } from "../i18n/utils";

// Commercial entry point for the Sensor Leasing service. Every visible string
// comes from the `join.*` keys, which hold the approved copy of the
// "Borrador de contenido — /unete" document; nothing is written inline here.
const t = useTranslations(getLangFromLocals(Astro.locals));

const { siteUrl } = await getRuntimeConfig();

// Same spacing tokens as the FAQ page, so both public pages line up.
const GUTTER = "px-[clamp(20px,5vw,64px)]";
const SHELL = `mx-auto max-w-[1100px] ${GUTTER}`;

const sectionTitle =
  "font-serif text-[clamp(21px,2.8vw,30px)] font-black leading-tight tracking-[-0.01em] text-near_black";
const cardClass =
  "flex flex-col gap-2.5 rounded-[14px] border border-bg-gray bg-white p-6";
const markClass =
  "flex h-9 w-9 shrink-0 items-center justify-center rounded-[9px] bg-light_green";

const inputClass =
  "w-full rounded-lg border border-bg-gray bg-white py-3 px-4 text-gray placeholder:text-lightgray focus:outline-none focus:ring-2 focus:ring-green focus:border-green transition";
const labelClass = "block text-sm font-semibold text-black mb-2";
---

<script>
  import { actions } from "astro:actions";

  const form = document.querySelector<HTMLFormElement>("#join-form");
  const submitBtn = document.querySelector<HTMLButtonElement>("#join-submit");
  const successMsg = document.querySelector<HTMLElement>("#join-success");
  const errorMsg = document.querySelector<HTMLElement>("#join-error");
  const counter = document.querySelector<HTMLElement>("#join-char-count");
  const message = document.querySelector<HTMLTextAreaElement>("#message");

  // Live character counter for the message field.
  message?.addEventListener("input", () => {
    if (counter) counter.textContent = String(message.value.length);
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    // Let the browser surface native validation (required fields, email format).
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    successMsg?.classList.add("hidden");
    errorMsg?.classList.add("hidden");

    const formData = new FormData(form);
    const { error } = await actions.joinNetwork(formData);

    if (error) {
      errorMsg?.classList.remove("hidden");
      errorMsg?.scrollIntoView({ behavior: "smooth", block: "center" });
      console.error(error);
      if (submitBtn) submitBtn.disabled = false;
    } else {
      form.reset();
      if (counter) counter.textContent = "0";
      form.classList.add("hidden");
      successMsg?.classList.remove("hidden");
      successMsg?.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  });
</script>

<BaseLayout>
  <!-- Breadcrumb -->
  <nav class={`${SHELL} pt-8 text-sm`} aria-label="breadcrumb">
    <a href={siteUrl} class="text-green_dark underline underline-offset-2">
      {t("join.breadcrumb.home")}
    </a>
    <span class="text-lightgray mx-2">/</span>
    <span class="text-gray">{t("join.breadcrumb.current")}</span>
  </nav>

  <!--
    HOW IT WORKS — opens the page, in place of the old hero.
    `minmax(0,…)` keeps the sensor render, whose source is 1376px wide, from
    ever widening its track past the fraction it was given.
  -->
  <section
    class={`${SHELL} grid grid-cols-1 items-center gap-8 pb-[clamp(32px,5vw,56px)] pt-6 md:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] md:gap-12`}
  >
    <div>
      <Typography
        variant="h1"
        customClass="!text-[clamp(26px,5vw,46px)] !font-black !text-near_black leading-[1.1] tracking-[-0.01em] mb-5"
      >
        {t("join.how.title")}
      </Typography>
      <p
        class="font-sans text-[clamp(15px,1.6vw,18px)] leading-[1.65] text-gray"
      >
        {t("join.how.p1")}
      </p>
      <div
        class="mt-5 rounded-r-xl border-l-4 border-green bg-light_green/50 py-4 px-5"
      >
        <p class="font-sans text-[15px] leading-[1.65] text-near_black">
          {t("join.how.p2")}
        </p>
      </div>
    </div>
    <Image
      src={SensorImage}
      alt={t("join.how.imageAlt")}
      widths={[320, 420, 700]}
      sizes="(min-width: 768px) 35vw, 90vw"
      loading="eager"
      class="order-first mx-auto h-auto w-full max-w-[380px] md:order-none"
    />
  </section>

  <!-- HOW MUCH DOES IT COST -->
  <section class="bg-white">
    <div class={`${SHELL} py-[clamp(40px,6vw,64px)]`}>
      <h2 class={sectionTitle}>{t("join.price.title")}</h2>
      <p
        class="mt-3 max-w-[62ch] font-sans text-[clamp(15px,1.6vw,18px)] leading-[1.65] text-gray"
      >
        {t("join.price.intro")}
      </p>

      <ol class="mt-8 flex flex-col">
        {
          PRICE_STEPS.map((step, index) => (
            <li class="relative grid grid-cols-[40px_1fr] gap-4 pb-5 last:pb-0">
              {index < PRICE_STEPS.length - 1 && (
                <span
                  class="absolute bottom-0 left-[19px] top-[42px] w-0.5 bg-bg-gray"
                  aria-hidden="true"
                />
              )}
              <span class="relative z-10 flex h-10 w-10 items-center justify-center rounded-full border-2 border-green bg-white font-serif text-[15px] font-black text-green_darker">
                {index + 1}
              </span>
              <div class="pt-1.5">
                <h3 class="font-serif text-base font-bold text-near_black">
                  {t(step.titleKey)}
                </h3>
                <p class="mt-1 font-sans text-sm leading-[1.55] text-gray">
                  {t(step.descKey)}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- WHAT THE MONTHLY SERVICE INCLUDES -->
  <section class={`${SHELL} py-[clamp(40px,6vw,64px)]`}>
    <h2 class={sectionTitle}>{t("join.includes.title")}</h2>
    <ul
      class="mt-7 grid grid-cols-[repeat(auto-fit,minmax(210px,1fr))] gap-4 list-none p-0"
    >
      {
        SERVICE_ITEMS.map((item) => (
          <li class={cardClass}>
            <span class={markClass}>
              <svg
                class="h-[19px] w-[19px] text-green_darker"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={GLYPHS[item.icon]} />
              </svg>
            </span>
            <p class="font-sans text-sm leading-[1.55] text-gray">
              {t(item.key)}
            </p>
          </li>
        ))
      }
    </ul>
    <div
      class="mt-6 rounded-[14px] border border-light_green bg-light_green/25 py-[18px] px-[22px]"
    >
      <p class="font-sans text-sm leading-[1.55] text-gray">
        {t("join.includes.standards")}
      </p>
    </div>
  </section>

  <!-- BENEFITS BY TYPE OF INSTITUTION -->
  <section class="bg-white">
    <div class={`${SHELL} py-[clamp(40px,6vw,64px)]`}>
      <h2 class={sectionTitle}>{t("join.segments.title")}</h2>
      <div
        class="mt-7 grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4"
      >
        {
          SEGMENTS.map((segment) => (
            <article class={`${cardClass} border-t-[3px] border-t-green`}>
              <span class={markClass}>
                <svg
                  class="h-[19px] w-[19px] text-green_darker"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={GLYPHS[segment.icon]} />
                </svg>
              </span>
              <h3 class="font-serif text-base font-bold text-near_black">
                {t(segment.titleKey)}
              </h3>
              <p class="font-sans text-sm leading-[1.55] text-gray">
                {t(segment.descKey)}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FORM -->
  <section
    class={`${SHELL} grid grid-cols-1 items-start gap-8 py-[clamp(40px,6vw,64px)] lg:grid-cols-[minmax(0,300px)_minmax(0,1fr)] lg:gap-10`}
  >
    <div class="flex flex-col gap-5">
      <div>
        <h2 class={sectionTitle}>{t("join.form.title")}</h2>
        <p class="mt-2 font-sans text-[15px] leading-[1.6] text-gray">
          {t("join.form.subtitle")}
        </p>
      </div>

      <div class="rounded-2xl bg-light_green/40 p-6">
        <p class="font-serif text-base font-bold text-near_black">
          {t("join.next.title")}
        </p>
        <p class="mt-1.5 font-sans text-sm leading-[1.55] text-gray">
          {t("join.next.desc")}
        </p>
      </div>
    </div>

    <div class="rounded-2xl bg-white shadow-lg p-6 md:p-10">
      <!-- Success state -->
      <div
        id="join-success"
        class="hidden rounded-xl border border-green bg-light_green/30 p-6 text-center"
        role="status"
        aria-live="polite"
      >
        <svg
          class="mx-auto h-12 w-12 text-green"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <path d="m9 11 3 3L22 4"></path>
        </svg>
        <p class="font-sans font-semibold text-black mt-4">
          {t("join.form.success")}
        </p>
      </div>

      <form id="join-form" class="flex flex-col gap-5" novalidate>
        <!-- Error state -->
        <p
          id="join-error"
          class="hidden rounded-lg bg-aqi-red-light/30 border border-aqi-red-dark text-aqi-red-dark text-sm font-medium p-3"
          role="alert"
          aria-live="assertive"
        >
          {t("join.form.error")}
        </p>

        <div
          style="position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden;"
        >
          <label for="website">Website</label>
          <input
            id="website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label class={labelClass} for="name">
              {t("join.form.name")}
              <span class="text-aqi-red-dark">*</span>
            </label>
            <input
              class={inputClass}
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder={t("join.form.namePlaceholder")}
              required
            />
          </div>
          <div>
            <label class={labelClass} for="email">
              {t("join.form.email")}
              <span class="text-aqi-red-dark">*</span>
            </label>
            <input
              class={inputClass}
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder={t("join.form.emailPlaceholder")}
              required
            />
          </div>
          <div>
            <label class={labelClass} for="phone">
              {t("join.form.phone")}
              <span class="text-aqi-red-dark">*</span>
            </label>
            <input
              class={inputClass}
              id="phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              placeholder={t("join.form.phonePlaceholder")}
              required
            />
          </div>
          <div>
            <label class={labelClass} for="organization">
              {t("join.form.organization")}
            </label>
            <input
              class={inputClass}
              id="organization"
              name="organization"
              type="text"
              autocomplete="organization"
              placeholder={t("join.form.organizationPlaceholder")}
            />
          </div>
          <div>
            <label class={labelClass} for="city">
              {t("join.form.city")}
              <span class="text-aqi-red-dark">*</span>
            </label>
            <input
              class={inputClass}
              id="city"
              name="city"
              type="text"
              placeholder={t("join.form.cityPlaceholder")}
              required
            />
          </div>
          <div>
            <label class={labelClass} for="department">
              {t("join.form.department")}
            </label>
            <div class="relative">
              <select
                class={inputClass + " appearance-none pr-10"}
                id="department"
                name="department"
              >
                <option value="">{t("join.form.departmentPlaceholder")}</option>
                {
                  PARAGUAY_DEPARTMENTS.map((dep) => (
                    <option value={dep}>{dep}</option>
                  ))
                }
              </select>
              <svg
                class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"
                ></path>
              </svg>
            </div>
          </div>
          <!-- Qualifying answers the "¿Cuánto cuesta?" section promises to ask for -->
          <div>
            <label class={labelClass} for="size">
              {t("join.form.size")}
              <span class="text-aqi-red-dark">*</span>
            </label>
            <input
              class={inputClass}
              id="size"
              name="size"
              type="text"
              placeholder={t("join.form.sizePlaceholder")}
              required
            />
          </div>
          <div>
            <label class={labelClass} for="approver">
              {t("join.form.approver")}
            </label>
            <input
              class={inputClass}
              id="approver"
              name="approver"
              type="text"
              placeholder={t("join.form.approverPlaceholder")}
            />
          </div>
        </div>

        <!-- Institution type -->
        <fieldset class="mt-1">
          <legend class={labelClass}>
            {t("join.form.institutionType")}
            <span class="text-aqi-red-dark">*</span>
          </legend>
          <div
            class="mt-1 grid grid-cols-2 gap-3 sm:grid-cols-[repeat(auto-fit,minmax(132px,1fr))]"
          >
            {
              INSTITUTION_TYPE_OPTIONS.map((option, index) => (
                <label class="cursor-pointer rounded-xl border border-bg-gray bg-white p-4 text-center flex flex-col items-center justify-center gap-2 transition hover:border-green focus-within:ring-2 focus-within:ring-green has-[:checked]:border-green has-[:checked]:bg-light_green/20 has-[:checked]:ring-1 has-[:checked]:ring-green">
                  <input
                    class="sr-only"
                    type="radio"
                    name="institutionType"
                    value={option.value}
                    required={index === 0}
                  />
                  <svg
                    class="h-6 w-6 text-green_dark"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={GLYPHS[option.icon]} />
                  </svg>
                  <span class="font-sans font-semibold text-[12.5px] leading-tight text-black">
                    {t(option.labelKey)}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <!-- Message -->
        <div>
          <label class={labelClass} for="message">
            {t("join.form.message")}
          </label>
          <textarea
            class={inputClass + " resize-y"}
            id="message"
            name="message"
            rows="4"
            maxlength="500"
            placeholder={t("join.form.messagePlaceholder")}></textarea>
          <p class="text-right text-xs text-lightgray mt-1">
            <span id="join-char-count">0</span>/500
          </p>
        </div>

        <!-- Consent -->
        <label class="flex items-start gap-3 cursor-pointer">
          <input
            class="mt-1 h-4 w-4 shrink-0 accent-green"
            type="checkbox"
            name="consent"
            value="on"
            required
          />
          <span class="font-sans text-sm text-gray">
            {t("join.form.consent")}
            <span class="text-aqi-red-dark">*</span>
          </span>
        </label>

        <button
          id="join-submit"
          type="submit"
          class="bg-green text-white font-sans font-bold uppercase py-4 px-6 rounded-md text-sm w-full hover:opacity-90 transition-opacity disabled:opacity-60 disabled:cursor-not-allowed flex items-center justify-center gap-2"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d={GLYPHS.leaf}></path>
          </svg>
          {t("join.form.submit")}
        </button>

        <p
          class="flex items-center justify-center gap-2 text-xs text-lightgray"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          {t("join.form.privacy")}
        </p>
      </form>
    </div>
  </section>

  <BackTop />
  <Footer />
</BaseLayout>
