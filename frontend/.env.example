# =============================================================================
# FRONTEND — Runtime Config (served via /runtime-config.json)
# Copy this file to frontend/.env and fill in the values.
# =============================================================================

# Base URL of the backend API. No trailing slash.
# For browser: relative URL through proxy (e.g., /api) or absolute (e.g., http://localhost/api)
BACKEND_URL=http://localhost/api

# Backend URL for server-side rendering (Node.js). Must be absolute URL.
# Used only during SSR in the frontend container for data fetching.
# In docker-compose: should point to the backend service (e.g., http://backend:8000/api)
BACKEND_URL_INTERNAL=http://backend:8000/api

# Default region ID used for initial map requests.
PUBLIC_REGION_DEFAULT_ID=8495471280173798472

# Max distance (in km) from a region's bbox for geolocation to assign a user
# to it automatically. Users farther than this from every region fall back
# to PUBLIC_REGION_DEFAULT_ID. Optional, defaults to 100.
PUBLIC_REGION_MAX_DISTANCE_KM=100

# Public canonical URL of this site. No trailing slash. Used for share links.
SITE_URL=http://localhost:4321

# Google Analytics measurement ID (optional). Leave empty (or keep the
# G-XXXXXXXXXX placeholder) to disable analytics entirely.
PUBLIC_GTAG=

# =============================================================================
# FRONTEND — Branding / White-label runtime config
# =============================================================================

# Contact inbox shown to users and used for outgoing contact mail.
CONTACT_MAIL=example@email.domain

# Public social and project link parts (domain/protocol are composed in code).
TWITTER_HANDLE=twitterhandle
TELEGRAM_CHANNEL=telegramchannel
FACEBOOK_PAGE=facebookpage
INSTAGRAM_HANDLE=instagramhandle
GITHUB_PATH=githubpath
SLACK_INVITE_PATH=slackinvitepath
APP_STORE_PATH=appstorepath
PLAY_STORE_APP_ID=playstoreappid

# =============================================================================
# FRONTEND — Email (server-side only, never exposed to the browser)
# =============================================================================

# Resend API key for sending contact-form emails.
# Replace with a real key per environment; never reuse the example value.
SMTP_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address shown in outgoing emails.
SMTP_SENDER=Respira <noreply@example.com>

# =============================================================================
# FRONTEND — Server
# =============================================================================

# Port the Node.js SSR server listens on inside the container.
FRONTEND_PORT=4321

# Network interface the server binds to. 0.0.0.0 means all interfaces.
# HOST=0.0.0.0
