---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/atoms/Footer.astro";
import BackTop from "../components/atoms/BackTop.astro";
import { RESEARCH_PAPERS } from "../data/research";
import Link from "../components/atoms/Link.astro";
import Fiuna from "../assets/logos/fiuna_green.svg";
import { Image } from "astro:assets";
import { EXTERNAL_RESOURCES_IMAGES } from "../data/images";
import Typography from "../components/atoms/Typography.astro";
import { getLangFromLocals, useTranslations } from "../i18n/utils";

const t = useTranslations(getLangFromLocals(Astro.locals));
---

<BaseLayout>
  <section
    class="grid md:grid-cols-2 grid-cols-1 md:p-20 p-12 gap-4 md:my-16 place-items-center"
  >
    <div class="md:col-span-1 sm:row-span-2 space-y-4 justify-stretch">
      <Typography variant="h6">{t("resources.dataSourceLabel")}</Typography>
      <Typography variant="h2">{t("resources.dataSourceTitle")}</Typography>
      <Typography variant="p">{t("resources.dataSource.p1")}</Typography>
      <Typography variant="p">{t("resources.dataSource.p2")}</Typography>
    </div>
    <div class="m-auto w-full h-full content-center justify-self-center">
      <Image
        alt=""
        src={Fiuna}
        loading="lazy"
        class="md:min-w-80 m-auto mt-8 md:mt-0"
      />
    </div>
  </section>
  <section class="bg-black md:p-20 p-12 md:py-32 py-24">
    <Typography variant="h2" color="white">
      {t("resources.research.title")}
    </Typography>
    {
      RESEARCH_PAPERS.map((research) => (
        <div class="py-6 md:max-w-[75%]">
          <Link
            text={research.title}
            href={research.link}
            customClass="text-lg text-white"
            variant="light"
          />
          <Typography variant="p-sm" color="white" customClass="pt-2">
            {research.authors}
          </Typography>
        </div>
      ))
    }
  </section>
  <section class="flex flex-col md:p-20 p-16 gap-4 md:py-32 py-24">
    <Typography variant="h2" customClass="pb-12"
      >{t("resources.external.title")}</Typography
    >
    <div class="grid md:grid-cols-4 gap-10">
      {
        EXTERNAL_RESOURCES_IMAGES.map((resource) => (
          <>
            <a
              class="flex flex-col md:my-4 justify-center"
              href={resource.link}
              target="_blank"
            >
              <Image alt={resource.alt} src={resource.path} loading="lazy" />
            </a>
            <a
              class={`md:order-last mb-4 md:m-0`}
              href={resource.link}
              target="_blank"
            >
              <Typography variant="label" customClass="underline">
                {resource.text}
              </Typography>
            </a>
          </>
        ))
      }
    </div>
  </section>
  <BackTop />
  <Footer />
</BaseLayout>
