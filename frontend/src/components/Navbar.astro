---
export const prerender = false;

import { Image } from "astro:assets";

import Button from "./atoms/Button.astro";
import NavbarItem from "./NavbarItem.astro";
import FullLogo from "../assets/logo.svg";
import IconLogo from "../assets/icon.svg";
import Close from "../assets/utils/close-icon.svg";
import {
  Astronav,
  MenuIcon,
  MenuItems,
  OpenIcon,
  CloseIcon,
} from "astro-navbar";
import { INSTITUTION_ACCESS, menu } from "../data/menu";
import LanguageSelector from "./LanguageSelector.astro";
import { getLangFromLocals, useTranslations } from "../i18n/utils";
import type { UIKey } from "../i18n/ui";
import { getSiteUrl } from "../store/runtime-config";

const lang = getLangFromLocals(Astro.locals);
const t = useTranslations(lang);
const baseUrl = await getSiteUrl();
---

<div
  class="lg:flex justify-between md:p-2 gap-5 bg-base drop-shadow-lg z-40 min-h-20 fixed w-full lg:px-10 px-6 items-center content-center"
>
  <Astronav closeOnClick>
    <div class="flex lg:w-auto justify-between items-center">
      <a href="/">
        <Image
          class="h-16 w-auto"
          alt="Respira"
          src={FullLogo}
          loading="eager"
        />
      </a>
      <div class="block lg:hidden">
        <MenuIcon class="w-4 h-4 text-gray-800">
          <OpenIcon>
            <Image src={IconLogo} alt="Open menu" />
          </OpenIcon>
          <CloseIcon>
            <Image src={Close} alt="Open menu" />
          </CloseIcon>
        </MenuIcon>
      </div>
    </div>
    <MenuItems class="hidden lg:flex w-full justify-center items-center">
      <ul class="flex flex-col lg:flex-row lg:gap-8 gap-8 lg:m-0 m-8">
        {
          menu.map((option) => (
            <NavbarItem
              title={t(`nav.${option.id}` as UIKey)}
              route={option.route}
              type={option.type}
            />
          ))
        }
        {
          /*
            The institutional door, for the collapsed menu. The desktop cluster
            below carries its own copy: `MenuItems` is hidden from `lg` up on
            everything but the section links, and duplicating the anchor is what
            keeps the entry point reachable at every width without moving the
            existing items around.
          */
        }
        <li class="block lg:hidden">
          <a
            href={INSTITUTION_ACCESS.route}
            class="font-sans font-semibold text-green_darker underline underline-offset-4"
            data-track-nav={t("nav.institution")}
            data-track-route={INSTITUTION_ACCESS.route}
          >
            {t("nav.institution")}
          </a>
        </li>
        <li class="lg:hidden block">
          <LanguageSelector />
        </li>
      </ul>
    </MenuItems>
    <div class="hidden lg:flex min-w-30 content-center items-center gap-4">
      <LanguageSelector />
      {
        /*
          A site-relative path, not `baseUrl` + path: it resolves against the
          origin serving the page, so the link follows the environment instead
          of depending on the runtime config being right.
        */
      }
      <a
        href={INSTITUTION_ACCESS.route}
        class="whitespace-nowrap"
        data-track-nav={t("nav.institution")}
        data-track-route={INSTITUTION_ACCESS.route}
      >
        <Button text={t("nav.institution")} variant="void" />
      </a>
      <a href={baseUrl}>
        <Button text={t("nav.map")} variant="void" />
      </a>
    </div>
  </Astronav>
</div>
