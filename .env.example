# =============================================================================
# DOCKER COMPOSE — Root environment file
# Copy this file to .env and fill in the values before running docker-compose.
# This single file is sufficient to bring up the full stack with docker-compose.
# =============================================================================

# =============================================================================
# COMPOSE — Orchestration
# =============================================================================

# Proxy build target stage. Choose one: local | development | production
ENVIRONMENT=local

# Host port mapped to the proxy container port 80.
PROXY_PORT=80

# Absolute path to the repository root used for certbot bind mounts.
# Leave commented to default to the current directory.
# HOST_WORKSPACE_FOLDER=/path/to/respira-webapp

# =============================================================================
# BACKEND — Core Application
# =============================================================================

# Django secret key. Use a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
BACKEND_SECRET_KEY=change-me-use-a-long-random-string

# Enable Django debug mode. Must be false in production.
BACKEND_DEBUG=false

# Port gunicorn listens on inside the backend container.
BACKEND_PORT=8000

# Run Django migrations automatically on container start.
BACKEND_RUN_MIGRATIONS=true

# Comma-separated list of origins allowed to make cross-site requests.
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# =============================================================================
# BACKEND — Database (PostgreSQL)
# All five vars must be set to enable PostgreSQL.
# If any is missing the backend falls back to SQLite (development only).
# =============================================================================

BACKEND_POSTGRES_DB=respira
BACKEND_POSTGRES_USER=respira_user
BACKEND_POSTGRES_PASSWORD=change-me
BACKEND_POSTGRES_HOST=localhost
BACKEND_POSTGRES_PORT=5432

# Comma-separated schemas added to search_path. "public" is always appended.
BACKEND_POSTGRES_SCHEMA=respira_gold

# =============================================================================
# BACKEND — Database SSL (optional)
# Uncomment and set the values your database provider requires.
# =============================================================================

# BACKEND_POSTGRES_SSLMODE=require
# BACKEND_POSTGRES_SSLROOTCERT=/app/certs/ca.pem
# BACKEND_POSTGRES_SSLCERT=/app/certs/client.crt
# BACKEND_POSTGRES_SSLKEY=/app/certs/client.key

# =============================================================================
# BACKEND — Process (optional)
# OS user/group gunicorn drops privileges to when the container starts as root.
# =============================================================================

# BACKEND_APP_USER=appuser
# BACKEND_APP_GROUP=appgroup

# =============================================================================
# BACKEND — Model Column Overrides (optional)
# Override only if your schema uses different column names than the defaults.
# =============================================================================

# BACKEND_STATION_READINGS_DATE_COLUMN=date_localtime
# BACKEND_INFERENCE_RESULTS_6H_COLUMN=forecast_6h
# BACKEND_INFERENCE_RESULTS_12H_COLUMN=forecast_12h

# =============================================================================
# FRONTEND — Runtime Config (served via /runtime-config.json)
# =============================================================================

# Base URL of the backend API. No trailing slash.
BACKEND_URL=http://localhost:8000

# Default region ID used for initial map requests.
PUBLIC_REGION_DEFAULT_ID=8495471280173798472

# Port the Node.js SSR server listens on inside the frontend container.
FRONTEND_PORT=4321

# Public canonical URL of this site. No trailing slash. Used for share links.
SITE_URL=http://localhost

# Google Analytics measurement ID.
PUBLIC_GTAG=G-XXXXXXXXXX

# =============================================================================
# FRONTEND — Email (server-side only, never exposed to the browser)
# =============================================================================

# Resend API key for contact-form emails.
SMTP_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address shown in outgoing emails.
SMTP_SENDER=Respira <noreply@example.com>

# =============================================================================
# PROXY SERVICE
# =============================================================================

# Public hostname used in server_name and HTTP→HTTPS redirects.
SERVER_HOST=localhost

# TLS certificate directory name under /etc/nginx/ssl/live/.
# Required for production and development targets. Omit for local.
# CERT_NAME=example.com
