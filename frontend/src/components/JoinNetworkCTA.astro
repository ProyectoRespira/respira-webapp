---
import { getRuntimeConfig } from "../store/runtime-config";
import { getLangFromLocals, useTranslations } from "../i18n/utils";

const t = useTranslations(getLangFromLocals(Astro.locals));
const { siteUrl } = await getRuntimeConfig();
const joinUrl = siteUrl + "/unete";

const points = [
  { text: t("home.cta.point1"), icon: "people" },
  { text: t("home.cta.point2"), icon: "chart" },
  { text: t("home.cta.point3"), icon: "pin" },
];

const GLYPHS: Record<string, string> = {
  people:
    "M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3Zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5Z",
  chart:
    "M4 13c-1.1 0-2 .9-2 2v4c0 1.1.9 2 2 2s2-.9 2-2v-4c0-1.1-.9-2-2-2Zm8-9c-1.1 0-2 .9-2 2v13c0 1.1.9 2 2 2s2-.9 2-2V6c0-1.1-.9-2-2-2Zm8 5c-1.1 0-2 .9-2 2v9c0 1.1.9 2 2 2s2-.9 2-2v-9c0-1.1-.9-2-2-2Z",
  pin: "M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z",
  leaf: "M6.05 8.05c-2.73 2.73-2.73 7.15-.02 9.88 1.47-3.4 4.09-6.24 7.36-7.93-2.77 2.34-4.71 5.61-5.39 9.32 2.6 1.23 5.8.78 7.95-1.37C19.43 14.47 20 4 20 4S9.53 4.57 6.05 8.05Z",
};

const nodes = [
  { cx: 72, cy: 48, r: 6, delay: "0s" },
  { cx: 28, cy: 72, r: 5, delay: "0.4s" },
  { cx: 55, cy: 80, r: 7, delay: "0.8s" },
  { cx: 82, cy: 78, r: 4, delay: "1.2s" },
  { cx: 18, cy: 38, r: 5, delay: "0.6s" },
  { cx: 45, cy: 28, r: 4, delay: "1s" },
  { cx: 90, cy: 30, r: 6, delay: "0.2s" },
  { cx: 38, cy: 58, r: 5, delay: "1.4s" },
  { cx: 65, cy: 62, r: 4, delay: "0.3s" },
];

const edges = [
  [0, 8], [0, 6], [0, 5],
  [1, 7], [1, 4], [1, 2],
  [2, 7], [2, 8], [2, 3],
  [3, 8], [3, 6],
  [4, 5], [5, 7],
];
---

<section
  id="join-cta"
  class="relative overflow-hidden bg-base"
  aria-labelledby="join-cta-title"
>
  <!-- Decorative blobs -->
  <div class="absolute -top-24 -right-24 w-96 h-96 bg-light_green/60 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-16 -left-16 w-72 h-72 bg-light_green/40 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 px-6 md:px-16 py-16 md:py-24 max-w-6xl mx-auto">
    <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">

      <!-- Left: text + CTA -->
      <div class="flex flex-col">
        <span class="inline-flex items-center gap-2 text-green text-sm font-sans font-semibold tracking-widest uppercase mb-6">
          <span class="w-6 h-px bg-green"></span>
          Proyecto Respira
        </span>
        <h2
          id="join-cta-title"
          class="font-serif text-black text-[2rem] md:text-[2.6rem] leading-tight mb-5"
        >
          {t("home.cta.title")}
        </h2>
        <p class="font-sans text-gray text-base leading-relaxed mb-10">
          {t("home.cta.subtitle")}
        </p>

        <ul class="flex flex-col gap-5 mb-10">
          {
            points.map((point) => (
              <li class="flex flex-row items-center gap-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-green/20 border border-green/30">
                  <svg class="h-5 w-5 text-green" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={GLYPHS[point.icon]} />
                  </svg>
                </span>
                <span class="font-sans text-black text-[0.95rem] leading-snug">
                  {point.text}
                </span>
              </li>
            ))
          }
        </ul>

        <a
          href={joinUrl}
          class="group inline-flex items-center justify-center gap-2 bg-green text-white font-sans font-bold py-4 px-7 rounded-md text-base w-full sm:w-fit hover:bg-green/90 transition-all hover:gap-3"
        >
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={GLYPHS.leaf}></path>
          </svg>
          {t("home.cta.button")}
          <svg class="h-4 w-4 shrink-0 translate-x-0 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </a>
      </div>

      <!-- Right: animated sensor network -->
      <div class="hidden md:flex items-center justify-center">
        <div class="relative w-full max-w-sm aspect-square">
          <svg
            viewBox="0 0 100 100"
            class="w-full h-full"
            xmlns="http://www.w3.org/2000/svg"
          >
            <!-- Edges -->
            {
              edges.map(([a, b]) => (
                <line
                  x1={nodes[a].cx} y1={nodes[a].cy}
                  x2={nodes[b].cx} y2={nodes[b].cy}
                  stroke="#4ade80"
                  stroke-width="0.4"
                  stroke-opacity="0.3"
                  class="network-edge"
                  style={`animation-delay: ${nodes[a].delay}`}
                />
              ))
            }
            <!-- Nodes -->
            {
              nodes.map((node, i) => (
                <g class="sensor-node" style={`animation-delay: ${node.delay}`}>
                  <circle
                    cx={node.cx} cy={node.cy} r={node.r + 4}
                    fill="#4ade80"
                    fill-opacity="0.08"
                    class="pulse-ring"
                    style={`animation-delay: ${node.delay}`}
                  />
                  <circle
                    cx={node.cx} cy={node.cy} r={node.r}
                    fill="#F0ECEA"
                    stroke="#4ade80"
                    stroke-width="0.8"
                    stroke-opacity="0.7"
                  />
                  <circle
                    cx={node.cx} cy={node.cy} r={node.r * 0.45}
                    fill="#4ade80"
                    fill-opacity="0.9"
                  />
                </g>
              ))
            }
          </svg>

        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .sensor-node {
    opacity: 0;
    animation: node-in 0.6s ease forwards;
  }

  .pulse-ring {
    animation: pulse 3s ease-in-out infinite;
  }

  .network-edge {
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
    animation: draw-edge 1s ease forwards;
  }

  @keyframes node-in {
    from { opacity: 0; transform: scale(0.5); }
    to   { opacity: 1; transform: scale(1); }
  }

  @keyframes pulse {
    0%, 100% { r: 10; opacity: 0.08; }
    50%       { r: 14; opacity: 0.18; }
  }

  @keyframes draw-edge {
    to { stroke-dashoffset: 0; }
  }


</style>
