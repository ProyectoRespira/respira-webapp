---
import Map from "../components/react/Map";
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/cards/Card.astro";
import AQICard from "../components/data-viz/AQICard.astro";
import Footer from "../components/atoms/Footer.astro";
import { AQI } from "../data/cards";
import BackTop from "../components/atoms/BackTop.astro";
import AppDownload from "../components/AppDownload.astro";
import JoinNetworkCTA from "../components/JoinNetworkCTA.astro";

const alertAQI = AQI.slice(2);
---

<BaseLayout>
  <Map client:only="react" />
  <div class="md:absolute top-0 w-full md:w-1/2 pointer-events-none">
    <Card />
  </div>
  <div
    class="relative z-10 bg-base w-full grid grid-cols-1 md:grid-cols-2 gap-12 px-8 py-8 md:px-16 md:py-12 xl:px-24"
  >
    <div>
      <JoinNetworkCTA />
    </div>
    <div class="mt-12 md:mt-0">
      <div class="flex flex-col gap-3 h-full">
        {alertAQI.map((aqi) => <AQICard card={aqi} variant="full" />)}
      </div>
    </div>
  </div>
  <AppDownload />
  <BackTop />
  <Footer />
</BaseLayout>
