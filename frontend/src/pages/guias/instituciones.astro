---
// User Guide — institutions.
//
// Converted from the Product artifact "Cómo entrar al panel de tu institución"
// (237acaff-e12e-487e-83e4-6b518fe88ec4). Static markup, no CMS: the source is
// a document, and this page is that document in the site's own chrome.
//
// Four deliberate departures from the source, all of them because that
// artifact was written for the internal Product team and this page is public:
//
//   * the demo credentials block is not reproduced — publishing a working
//     login on the public site would hand it to anyone who finds the page;
//   * the voice is the institution's ("tu panel"), not a third-person
//     description of what an institution sees;
//   * the two passages saying password recovery does not exist are replaced by
//     the flow this ticket adds, since they are no longer true;
//   * the dashboard walkthrough shows a real screenshot of the panel instead of
//     the artifact's CSS recreation. The sections under it describe what is in
//     that image, so a drawing would go stale the first time the panel changes.
//
// `assets/guias/panel-institucional.png` is a capture of the running dashboard
// against seeded sample data — never a real client's. To refresh it: seed an
// institution with a station, readings, alerts and action logs, log in, and
// capture `/institucion/dashboard` full-page at 1280px CSS width, with the
// Astro dev toolbar removed from the DOM first.
//
// Trilingual: the prose lives in `i18n/guides.ts`, and the strings this page
// quotes from the panel itself come from `i18n/institution.ts`, so a quoted
// message always matches what the reader would actually see on screen.

import { Image } from "astro:assets";

import GuideLayout from "../../layouts/GuideLayout.astro";
import Callout from "../../components/guides/Callout.astro";
import PanelScreenshot from "../../assets/guias/panel-institucional.png";
import { GUIDE_ROUTES, INSTITUTION_ACCESS } from "../../data/menu";
import { INSTITUTION_FORGOT_PASSWORD_PATH } from "../../utils/institution-session";
import { useInstitutionCopy } from "../../i18n/institution";
import { useGuideCopy } from "../../i18n/guides";
import { getLangFromLocals } from "../../i18n/utils";

const lang = getLangFromLocals(Astro.locals);
const c = useGuideCopy(lang);
const institutionCopy = useInstitutionCopy(lang);

const sections = [
  { id: "entrar", label: c.instNavEntrar },
  { id: "errores", label: c.instNavErrores },
  { id: "clave", label: c.instNavClave },
  { id: "recorrido", label: c.instNavRecorrido },
  { id: "salir", label: c.instNavSalir },
  { id: "faq", label: c.instNavFaq },
];
---

<GuideLayout
  eyebrow={c.instEyebrow}
  title={c.instTitle}
  dek={c.instDek}
  meta={[c.instMeta]}
  sections={sections}
>
  <section id="entrar">
    <h2>{c.instEntrarTitle}</h2>
    <p class="lede">
      {c.instEntrarLede1}{" "}<a href={INSTITUTION_ACCESS.route}
        >{INSTITUTION_ACCESS.title}</a
      >{c.instEntrarLede2}
    </p>

    <figure
      class="my-6 overflow-hidden rounded-xl border border-bg-gray bg-white"
    >
      <div
        class="flex items-center gap-1.5 border-b border-bg-gray bg-base px-3.5 py-2.5"
      >
        <span class="block h-2 w-2 rounded-full bg-bg-gray"></span>
        <span class="block h-2 w-2 rounded-full bg-bg-gray"></span>
        <span class="block h-2 w-2 rounded-full bg-bg-gray"></span>
        <span class="ml-2 truncate font-sans text-[12px] text-lightgray"
          >proyectorespira.net{INSTITUTION_ACCESS.route}</span
        >
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2">
        <div
          class="flex flex-col justify-center gap-2 bg-near_black px-6 py-7 text-white"
        >
          <span class="font-serif text-[17px] font-bold">respira</span>
          <span class="block h-[3px] w-8 rounded bg-green"></span>
          <p class="max-w-[20ch] font-serif text-[15px] font-bold leading-snug">
            {institutionCopy.loginTagline}
          </p>
          <p class="max-w-[28ch] font-sans text-[12px] text-bg-gray">
            {institutionCopy.loginBlurb}
          </p>
        </div>
        <div class="flex flex-col justify-center gap-3 px-6 py-7">
          <p class="font-serif text-[16px] font-bold">
            {institutionCopy.loginTitle}
          </p>
          <p class="font-sans text-[12px] text-gray">
            {institutionCopy.loginSubtitle}
          </p>
          <div>
            <p
              class="mb-1 font-sans text-[10px] font-bold uppercase tracking-wider text-lightgray"
            >
              {institutionCopy.loginEmail}
            </p>
            <div
              class="rounded-md border border-bg-gray bg-base px-2.5 py-1.5 font-sans text-[13px] text-lightgray"
            >
              {c.instMockEmailSample}
            </div>
          </div>
          <div>
            <p
              class="mb-1 font-sans text-[10px] font-bold uppercase tracking-wider text-lightgray"
            >
              {institutionCopy.loginPassword}
            </p>
            <div
              class="rounded-md border border-bg-gray bg-base px-2.5 py-1.5 font-sans text-[13px] text-lightgray"
            >
              ••••••••••••
            </div>
          </div>
          <span
            class="w-fit rounded-md bg-green_dark px-4 py-1.5 font-sans text-[12px] font-bold uppercase tracking-wide text-white"
            >{institutionCopy.loginSubmit}</span
          >
          <p class="font-sans text-[11px] text-lightgray">
            {institutionCopy.forgotLink}
          </p>
        </div>
      </div>
      <figcaption class="px-4 py-3">{c.instMockCaption}</figcaption>
    </figure>

    <p>
      {c.instEntrarBody1} <strong>{c.instEntrarBodyEmail}</strong>{" "}
      {c.instEntrarBodyAnd} <strong>{c.instEntrarBodyPassword}</strong>{
        c.instEntrarBody2
      } <strong>{institutionCopy.forgotLink}</strong> {c.instEntrarBody3}
    </p>

    <Callout label={c.instEntrarCalloutLabel}>
      <p>{c.instEntrarCalloutBody}</p>
    </Callout>
  </section>

  <section id="errores">
    <h2>{c.instErroresTitle}</h2>
    <p class="lede">{c.instErroresLede}</p>

    <h3>{c.instErroresCredsTitle}</h3>
    <p>{c.instErroresCredsBody}</p>

    <h3>{c.instErroresNoInstTitle}</h3>
    <p>{c.instErroresNoInstBody}</p>

    <h3>{c.instErroresThrottledTitle}</h3>
    <p>{c.instErroresThrottledBody}</p>

    <h3>{c.instErroresServerTitle}</h3>
    <p>{c.instErroresServerBody}</p>
  </section>

  <section id="clave">
    <h2>{c.instClaveTitle}</h2>
    <p class="lede">{c.instClaveLede}</p>

    <ol class="steps">
      <li>
        {c.instClaveStep1a}{" "}<a href={INSTITUTION_FORGOT_PASSWORD_PATH}
          >{institutionCopy.forgotLink}</a
        >.
      </li>
      <li>
        {c.instClaveStep2a} <strong>{c.instClaveStep2b}</strong>.
      </li>
      <li>{c.instClaveStep3}</li>
      <li>{c.instClaveStep4}</li>
      <li>{c.instClaveStep5}</li>
    </ol>

    <Callout label={c.instClaveCalloutLabel} tone="warn">
      <p>{c.instClaveCalloutBody}</p>
    </Callout>

    <p>{c.instClaveRules}</p>

    <Callout label={c.instClavePrivacyLabel}>
      <p>{c.instClavePrivacyBody}</p>
    </Callout>
  </section>

  <section id="recorrido">
    <h2>{c.instRecorridoTitle}</h2>
    <p class="lede">{c.instRecorridoLede}</p>

    {
      /*
        A real capture of the panel, not a drawing of it: the sections below
        describe what is in this image, so a recreation would drift away from
        the product the first time the dashboard changes. Run through
        `astro:assets` so the 2x PNG ships as a sized, lazy, modern-format
        image instead of half a megabyte on every visit.
      */
    }
    <figure class="my-6">
      <Image
        src={PanelScreenshot}
        alt={c.instScreenshotAlt}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 700px, 100vw"
        loading="lazy"
        class="h-auto w-full rounded-xl border border-bg-gray"
      />
      <figcaption>{c.instScreenshotCaption}</figcaption>
    </figure>

    <h3>{c.instAirTitle}</h3>
    <p>{c.instAirBody}</p>

    <h3>{c.instSensorTitle}</h3>
    <p>{c.instSensorBody}</p>

    <h3>{c.instHistoryTitle}</h3>
    <p>{c.instHistoryBody}</p>

    <h3>{c.instActionsTitle}</h3>
    <p>{c.instActionsBody}</p>

    <h3>{c.instAlertsTitle}</h3>
    <p>{c.instAlertsBody}</p>

    <h3>{c.instDownloadsTitle}</h3>
    <p>{c.instDownloadsBody}</p>
    <Callout label={c.instDownloadsCalloutLabel} tone="warn">
      <p>{c.instDownloadsCalloutBody}</p>
    </Callout>

    <h3>{c.instContactTitle}</h3>
    <p>{c.instContactBody}</p>
  </section>

  <section id="salir">
    <h2>{c.instSalirTitle}</h2>
    <p class="lede">{c.instSalirBody}</p>
  </section>

  <section id="faq">
    <h2>{c.instFaqTitle}</h2>

    <h3>{c.instFaqQ1}</h3>
    <p>
      {c.instFaqA1a} <a href={INSTITUTION_FORGOT_PASSWORD_PATH}
        >{institutionCopy.forgotLink}</a
      >{c.instFaqA1b} <a href="#clave">{c.instFaqA1Link}</a>{c.instFaqA1c}
    </p>

    <h3>{c.instFaqQ2}</h3>
    <p>{c.instFaqA2}</p>

    <h3>{c.instFaqQ3}</h3>
    <p>{c.instFaqA3}</p>

    <h3>{c.instFaqQ4}</h3>
    <p>{c.instFaqA4}</p>

    <h3>{c.instFaqQ5}</h3>
    <p>
      {c.instFaqA5a} <a href={GUIDE_ROUTES.admin}>{c.instFaqA5Link}</a>{
        c.instFaqA5b
      }
    </p>
  </section>
</GuideLayout>
