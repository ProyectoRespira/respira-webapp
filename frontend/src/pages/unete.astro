---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/atoms/Footer.astro";
import BackTop from "../components/atoms/BackTop.astro";
import Typography from "../components/atoms/Typography.astro";
import { PARAGUAY_DEPARTMENTS } from "../data/departments";
import { BASE_URL } from "../data/constants";
import { getLangFromLocals, useTranslations } from "../i18n/utils";

const t = useTranslations(getLangFromLocals(Astro.locals));

const benefits = [
  {
    titleKey: "join.benefit.impact.title",
    descKey: "join.benefit.impact.desc",
    icon: "people",
  },
  {
    titleKey: "join.benefit.data.title",
    descKey: "join.benefit.data.desc",
    icon: "chart",
  },
  {
    titleKey: "join.benefit.health.title",
    descKey: "join.benefit.health.desc",
    icon: "heart",
  },
  {
    titleKey: "join.benefit.tech.title",
    descKey: "join.benefit.tech.desc",
    icon: "leaf",
  },
] as const;

// Interest options. `value` matches the keys accepted by the joinNetwork action.
const interests = [
  {
    value: "institution",
    labelKey: "join.form.interest.institution",
    hintKey: "join.form.interest.institutionHint",
    icon: "building",
  },
  {
    value: "home",
    labelKey: "join.form.interest.home",
    hintKey: "join.form.interest.homeHint",
    icon: "home",
  },
  {
    value: "community",
    labelKey: "join.form.interest.community",
    hintKey: "join.form.interest.communityHint",
    icon: "people",
  },
  {
    value: "ngo",
    labelKey: "join.form.interest.ngo",
    hintKey: "join.form.interest.ngoHint",
    icon: "people",
  },
  {
    value: "other",
    labelKey: "join.form.interest.other",
    hintKey: "join.form.interest.otherHint",
    icon: "dots",
  },
] as const;

// Solid (filled) SVG glyph paths, drawn with `fill="currentColor"` so they read
// as the green emoji-style icons in the design. Shared by the benefit list and
// the interest cards. viewBox is 0 0 24 24.
const GLYPHS: Record<string, string> = {
  people:
    "M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3Zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5Z",
  chart:
    "M4 13c-1.1 0-2 .9-2 2v4c0 1.1.9 2 2 2s2-.9 2-2v-4c0-1.1-.9-2-2-2Zm8-9c-1.1 0-2 .9-2 2v13c0 1.1.9 2 2 2s2-.9 2-2V6c0-1.1-.9-2-2-2Zm8 5c-1.1 0-2 .9-2 2v9c0 1.1.9 2 2 2s2-.9 2-2v-9c0-1.1-.9-2-2-2Z",
  heart:
    "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35Z",
  leaf: "M6.05 8.05c-2.73 2.73-2.73 7.15-.02 9.88 1.47-3.4 4.09-6.24 7.36-7.93-2.77 2.34-4.71 5.61-5.39 9.32 2.6 1.23 5.8.78 7.95-1.37C19.43 14.47 20 4 20 4S9.53 4.57 6.05 8.05Z",
  building:
    "M4 10v7h3v-7H4Zm6 0v7h3v-7h-3ZM2 22h19v-3H2v3Zm14-12v7h3v-7h-3Zm-4.5-9L2 6v2h19V6l-9.5-5Z",
  home: "M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z",
  dots: "M6 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2Zm12 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2Zm-6 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2Z",
};

const inputClass =
  "w-full rounded-lg border border-bg-gray bg-white py-3 px-4 text-gray placeholder:text-lightgray focus:outline-none focus:ring-2 focus:ring-green focus:border-green transition";
const labelClass = "block text-sm font-semibold text-black mb-2";
---

<script>
  import { actions } from "astro:actions";

  const form = document.querySelector<HTMLFormElement>("#join-form");
  const submitBtn = document.querySelector<HTMLButtonElement>("#join-submit");
  const successMsg = document.querySelector<HTMLElement>("#join-success");
  const errorMsg = document.querySelector<HTMLElement>("#join-error");
  const counter = document.querySelector<HTMLElement>("#join-char-count");
  const message = document.querySelector<HTMLTextAreaElement>("#message");

  // Live character counter for the message field.
  message?.addEventListener("input", () => {
    if (counter) counter.textContent = String(message.value.length);
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    // Let the browser surface native validation (required fields, email format).
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    successMsg?.classList.add("hidden");
    errorMsg?.classList.add("hidden");

    const formData = new FormData(form);
    const { error } = await actions.joinNetwork(formData);

    if (error) {
      errorMsg?.classList.remove("hidden");
      errorMsg?.scrollIntoView({ behavior: "smooth", block: "center" });
      console.error(error);
      if (submitBtn) submitBtn.disabled = false;
    } else {
      form.reset();
      if (counter) counter.textContent = "0";
      form.classList.add("hidden");
      successMsg?.classList.remove("hidden");
      successMsg?.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  });
</script>

<BaseLayout>
  <section class="mx-auto max-w-[96rem] px-6 md:px-12 lg:px-16 py-10 md:py-16">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-8" aria-label="breadcrumb">
      <a href={BASE_URL} class="text-green underline underline-offset-2">
        {t("join.breadcrumb.home")}
      </a>
      <span class="text-lightgray mx-2">/</span>
      <span class="text-gray">{t("join.breadcrumb.current")}</span>
    </nav>

    <div
      class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.6fr)_minmax(0,1fr)] gap-10 lg:gap-16"
    >
      <!-- Left: info -->
      <div class="flex flex-col space-y-6">
        <Typography variant="h1" customClass="leading-tight">
          {t("join.hero.title")}
        </Typography>
        <Typography variant="p" color="gray">
          {t("join.hero.subtitle")}
        </Typography>
        <Typography variant="p" color="gray">
          {t("join.hero.subtitle2")}
        </Typography>

        <ul class="flex flex-col space-y-5 pt-2">
          {
            benefits.map((benefit) => (
              <li class="flex flex-row items-start gap-4">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-light_green/50">
                  <svg
                    class="h-7 w-7 text-green"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={GLYPHS[benefit.icon]} />
                  </svg>
                </span>
                <div>
                  <p class="font-sans font-bold text-black">
                    {t(benefit.titleKey)}
                  </p>
                  <p class="font-sans text-sm text-gray">
                    {t(benefit.descKey)}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>

        <div
          class="flex flex-row items-start gap-4 rounded-xl bg-light_green/40 p-6 mt-4"
        >
          <span
            class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-green/20"
          >
            <svg
              class="h-7 w-7 text-green"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={GLYPHS.leaf}></path>
            </svg>
          </span>
          <div>
            <p class="font-sans font-bold text-black">{t("join.next.title")}</p>
            <p class="font-sans text-sm text-gray">{t("join.next.desc")}</p>
          </div>
        </div>
      </div>

      <!-- Right: form -->
      <div class="rounded-2xl bg-white shadow-lg p-6 md:p-10">
        <Typography variant="h4" customClass="!text-green">
          {t("join.form.title")}
        </Typography>
        <p class="font-sans text-sm text-gray mt-1 mb-6">
          {t("join.form.subtitle")}
        </p>

        <!-- Success state -->
        <div
          id="join-success"
          class="hidden rounded-xl border border-green bg-light_green/30 p-6 text-center"
          role="status"
          aria-live="polite"
        >
          <svg
            class="mx-auto h-12 w-12 text-green"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <path d="m9 11 3 3L22 4"></path>
          </svg>
          <p class="font-sans font-semibold text-black mt-4">
            {t("join.form.success")}
          </p>
        </div>

        <form id="join-form" class="flex flex-col gap-5" novalidate>
          <!-- Error state -->
          <p
            id="join-error"
            class="hidden rounded-lg bg-aqi-red-light/30 border border-aqi-red-dark text-aqi-red-dark text-sm font-medium p-3"
            role="alert"
            aria-live="assertive"
          >
            {t("join.form.error")}
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label class={labelClass} for="name">
                {t("join.form.name")}
                <span class="text-aqi-red-dark">*</span>
              </label>
              <input
                class={inputClass}
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                placeholder={t("join.form.namePlaceholder")}
                required
              />
            </div>
            <div>
              <label class={labelClass} for="email">
                {t("join.form.email")}
                <span class="text-aqi-red-dark">*</span>
              </label>
              <input
                class={inputClass}
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder={t("join.form.emailPlaceholder")}
                required
              />
            </div>
            <div>
              <label class={labelClass} for="phone">
                {t("join.form.phone")}
                <span class="text-aqi-red-dark">*</span>
              </label>
              <input
                class={inputClass}
                id="phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                placeholder={t("join.form.phonePlaceholder")}
                required
              />
            </div>
            <div>
              <label class={labelClass} for="organization">
                {t("join.form.organization")}
              </label>
              <input
                class={inputClass}
                id="organization"
                name="organization"
                type="text"
                autocomplete="organization"
                placeholder={t("join.form.organizationPlaceholder")}
              />
            </div>
            <div>
              <label class={labelClass} for="city">
                {t("join.form.city")}
                <span class="text-aqi-red-dark">*</span>
              </label>
              <input
                class={inputClass}
                id="city"
                name="city"
                type="text"
                placeholder={t("join.form.cityPlaceholder")}
                required
              />
            </div>
            <div>
              <label class={labelClass} for="department">
                {t("join.form.department")}
              </label>
              <div class="relative">
                <select
                  class={inputClass + " appearance-none pr-10"}
                  id="department"
                  name="department"
                >
                  <option value=""
                    >{t("join.form.departmentPlaceholder")}</option
                  >
                  {
                    PARAGUAY_DEPARTMENTS.map((dep) => (
                      <option value={dep}>{dep}</option>
                    ))
                  }
                </select>
                <svg
                  class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"
                  ></path>
                </svg>
              </div>
            </div>
          </div>

          <!-- Interest type -->
          <fieldset class="mt-1">
            <legend class={labelClass}>
              {t("join.form.interest")}
              <span class="text-aqi-red-dark">*</span>
            </legend>
            <div
              class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-5 gap-3 mt-1"
            >
              {
                interests.map((interest, index) => (
                  <label class="cursor-pointer rounded-xl border border-bg-gray bg-white p-4 text-center flex flex-col items-center gap-2 transition hover:border-green focus-within:ring-2 focus-within:ring-green has-[:checked]:border-green has-[:checked]:bg-light_green/20 has-[:checked]:ring-1 has-[:checked]:ring-green">
                    <input
                      class="sr-only"
                      type="radio"
                      name="interestType"
                      value={interest.value}
                      required={index === 0}
                    />
                    <svg
                      class="h-8 w-8 text-green"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d={GLYPHS[interest.icon]} />
                    </svg>
                    <span class="font-sans font-semibold text-sm text-black">
                      {t(interest.labelKey)}
                    </span>
                    {t(interest.hintKey) && (
                      <span class="font-sans text-[0.7rem] text-gray leading-tight">
                        {t(interest.hintKey)}
                      </span>
                    )}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <!-- Message -->
          <div>
            <label class={labelClass} for="message">
              {t("join.form.message")}
            </label>
            <textarea
              class={inputClass + " resize-y"}
              id="message"
              name="message"
              rows="4"
              maxlength="500"
              placeholder={t("join.form.messagePlaceholder")}></textarea>
            <p class="text-right text-xs text-lightgray mt-1">
              <span id="join-char-count">0</span>/500
            </p>
          </div>

          <!-- Consent -->
          <label class="flex items-start gap-3 cursor-pointer">
            <input
              class="mt-1 h-4 w-4 shrink-0 accent-green"
              type="checkbox"
              name="consent"
              value="on"
              required
            />
            <span class="font-sans text-sm text-gray">
              {t("join.form.consent")}
              <span class="text-aqi-red-dark">*</span>
            </span>
          </label>

          <button
            id="join-submit"
            type="submit"
            class="bg-green text-white font-sans font-bold uppercase py-4 px-6 rounded-md text-sm w-full hover:opacity-90 transition-opacity disabled:opacity-60 disabled:cursor-not-allowed flex items-center justify-center gap-2"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={GLYPHS.leaf}></path>
            </svg>
            {t("join.form.submit")}
          </button>

          <p
            class="flex items-center justify-center gap-2 text-xs text-lightgray"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            {t("join.form.privacy")}
          </p>
        </form>
      </div>
    </div>
  </section>
  <BackTop />
  <Footer />
</BaseLayout>
