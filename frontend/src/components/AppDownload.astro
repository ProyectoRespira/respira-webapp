---
import { Image } from "astro:assets";
import Typography from "./atoms/Typography.astro";
import AppleIcon from "../assets/icons/apple_icon.svg";
import GooglePlayIcon from "../assets/icons/google_play_icon.svg";
import AppPromo from "../assets/mk_respira.png";
import { APP_STORE_URL, PLAY_STORE_URL } from "../data/constants";

const stores = [
  {
    href: APP_STORE_URL,
    icon: AppleIcon,
    alt: "Apple logo",
    label: "Descargá en la",
    name: "App Store",
  },
  {
    href: PLAY_STORE_URL,
    icon: GooglePlayIcon,
    alt: "Google Play logo",
    label: "Disponible en",
    name: "Google Play",
  },
];
---

<div class="px-6 md:px-16 py-12 md:py-16">
  <div
    id="app-banner"
    class="app-banner max-w-5xl mx-auto grid md:grid-cols-2 rounded-3xl overflow-hidden shadow-xl bg-green"
  >
    <div
      class="flex flex-col justify-center space-y-6 p-8 md:p-14 order-2 md:order-1"
    >
      <Typography variant="h2" color="white"
        >Descargá la app de Proyecto Respira</Typography
      >
      <Typography variant="p" color="white">
        Consultá la calidad del aire desde tu celular y agregá el widget para
        ver el AQI al instante desde tu pantalla principal, sin abrir la app.
      </Typography>
      <div class="flex flex-col sm:flex-row gap-4">
        {
          stores.map((store) => (
            <a
              href={store.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 bg-black text-white rounded-xl px-5 py-3 w-full sm:w-auto hover:opacity-90 transition-opacity"
            >
              <Image src={store.icon} alt={store.alt} class="h-7 w-auto" />
              <span class="flex flex-col leading-tight text-left">
                <span class="text-[0.7rem] font-sans">{store.label}</span>
                <span class="text-[1.15rem] font-sans font-semibold">
                  {store.name}
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="order-1 md:order-2 min-h-[14rem] md:min-h-[22rem]">
      <Image
        src={AppPromo}
        alt="Aplicación móvil de Proyecto Respira"
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>
  </div>
</div>

<script>
  const banner = document.getElementById("app-banner");
  if (banner) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          banner.classList.add("app-banner-visible");
          observer.disconnect();
        }
      },
      { threshold: 0, rootMargin: "0px 0px -60px 0px" },
    );
    observer.observe(banner);
  }
</script>

<style>
  .app-banner {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  .app-banner-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
