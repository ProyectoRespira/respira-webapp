# =============================================================================
# BACKEND — Core Application
# Copy this file to backend/.env and fill in the values.
# =============================================================================

# Django secret key. Use a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
BACKEND_SECRET_KEY=change-me-use-a-long-random-string

# Enable Django debug mode. Must be false in production.
BACKEND_DEBUG=false

# Port gunicorn binds to inside the container.
BACKEND_PORT=8000

# =============================================================================
# BACKEND — Database (PostgreSQL)
# All five vars must be set to enable PostgreSQL.
# If any is missing the backend falls back to SQLite (development only).
# =============================================================================

BACKEND_POSTGRES_DB=respira
BACKEND_POSTGRES_USER=respira_user
BACKEND_POSTGRES_PASSWORD=change-me
BACKEND_POSTGRES_HOST=localhost
BACKEND_POSTGRES_PORT=5432

# Comma-separated schemas added to search_path. "public" is always appended.
BACKEND_POSTGRES_SCHEMA=respira_gold

# =============================================================================
# BACKEND — Database SSL (optional)
# Uncomment and set the values your database provider requires.
# =============================================================================

# BACKEND_POSTGRES_SSLMODE=require
# BACKEND_POSTGRES_SSLROOTCERT=/app/certs/ca.pem
# BACKEND_POSTGRES_SSLCERT=/app/certs/client.crt
# BACKEND_POSTGRES_SSLKEY=/app/certs/client.key

# =============================================================================
# BACKEND — API
# =============================================================================

# Comma-separated list of origins allowed to make cross-site requests.
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# BACKEND — Migrations & Process
# =============================================================================

# Run Django migrations automatically on container start.
BACKEND_RUN_MIGRATIONS=true

# OS user and group gunicorn drops privileges to.
# Only takes effect when the container starts as root.
# BACKEND_APP_USER=appuser
# BACKEND_APP_GROUP=appgroup

# =============================================================================
# BACKEND — Model Column Overrides (optional)
# Override DB column name mappings if your schema uses different names.
# =============================================================================

# BACKEND_STATION_READINGS_DATE_COLUMN=date_localtime
# BACKEND_INFERENCE_RESULTS_6H_COLUMN=forecast_6h
# BACKEND_INFERENCE_RESULTS_12H_COLUMN=forecast_12h
