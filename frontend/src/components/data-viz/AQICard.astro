---
import { Image } from "astro:assets";
import type { AQICard } from "../../data/cards";
import { getTextColor } from "../../utils";
import Typography from "../atoms/Typography.astro";
import { getLangFromLocals, useTranslations } from "../../i18n/utils";
import type { UIKey } from "../../i18n/ui";
interface Props {
  card: AQICard;
  variant?: "full" | "abrev" | "other";
}
const { card, variant } = Astro.props;

const t = useTranslations(getLangFromLocals(Astro.locals));
const title = t(`aqi.${card.id}.title` as UIKey);
const description = t(`aqi.${card.id}.description` as UIKey);
---

<div class=`bg-${card.color} w-full  rounded-xl p-10`>
  <div class="flex flex-row w-full min-h-20">
    <div class="flex flex-col align-center justify-center mr-4">
      <Image alt={card.icon.alt} src={card.icon.path} height={60} width={60} />
    </div>
    <div class="flex flex-col w-full justify-center">
      <div class="flex flex-row mb-2 flex-wrap">
        <Typography
          variant="h5"
          color={getTextColor(card.color)}
          customClass={variant && variant === "full"
            ? " uppercase grow"
            : "grow"}>{title}</Typography
        >
        <Typography variant="h5" color={getTextColor(card.color)}
          >{card.range[0]}-{card.range[1]}</Typography
        >
      </div>
      <Typography variant="p" color={getTextColor(card.color)}
        >{description}</Typography
      >
    </div>
  </div>
</div>
