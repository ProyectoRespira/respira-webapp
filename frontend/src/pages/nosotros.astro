---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/atoms/Footer.astro";
import BackTop from "../components/atoms/BackTop.astro";
import { Picture, Image } from "astro:assets";
import Typography from "../components/atoms/Typography.astro";
import Link from "../components/atoms/Link.astro";
import Button from "../components/atoms/Button.astro";
import MapImage from "../assets/map.png";
import ChartImage from "../assets/chart.png";
import Map2Image from "../assets/map2.png";
import GithubIcon from "../assets/logos/github_icon.svg";
import Github from "../assets/logos/github.svg";
import { TEAM } from "../data/team";
import { ORGANIZATIONS } from "../data/images";
import { GITHUB_URL } from "../data/constants";
import { getLangFromLocals, useTranslations } from "../i18n/utils";

const t = useTranslations(getLangFromLocals(Astro.locals));
---

<BaseLayout>
  <section
    class="grid md:grid-cols-2 md:p-20 p-0 gap-12 md:my-16 place-items-center"
  >
    <div class="space-y-4 justify-stretch md:m-0 m-12">
      <Typography variant="h1">{t("about.title")}</Typography>
      <Typography variant="p">{t("about.p1")}</Typography>
      <Typography variant="p">{t("about.p2")}</Typography>
      <Typography variant="p">{t("about.p3")}</Typography>
      <Link
        text={t("about.protectLink")}
        customClass="text-gray"
        href={"https://www.airnow.gov/sites/default/files/2018-05/air-quality-guide_particle_SPA.pdf"}
      />
    </div>
    <Image alt="Map of Asuncion" src={MapImage} loading="eager" />
  </section>
  <section
    class="grid md:grid-cols-2 md:px-12 gap-12 md:py-32 place-items-center justify-center bg-black pb-12"
  >
    <Image alt="Forecast chart" src={ChartImage} loading="eager" />
    <div
      class="space-y-4 justify-stretch m-12 md:m-0 md:order-last order-first"
    >
      <Typography variant="h2" color="white"
        >{t("about.forecasts.title")}</Typography
      >
      <Typography variant="p" color="white"
        >{t("about.forecasts.p1")}</Typography
      >
      <Typography variant="p" color="white"
        >{t("about.forecasts.p2")}</Typography
      >
    </div>
  </section>
  <section
    class="grid md:grid-cols-3 md:px-16 gap-12 md:py-32 place-content-stretch place-items-start justify-center"
  >
    <div class="space-y-4 justify-stretch m-12 md:m-0 md:col-span-2">
      <Typography variant="h2">{t("about.why.title")}</Typography>
      <Typography variant="p">{t("about.why.p1")}</Typography>
      <Typography variant="p">{t("about.why.p2")}</Typography>
      <ul class="list-disc pl-4">
        <li>{t("about.why.health.earlyDeath")}</li>
        <li>{t("about.why.health.cough")}</li>
        <li>{t("about.why.health.lung")}</li>
        <li>{t("about.why.health.asthma")}</li>
        <li>{t("about.why.health.heart")}</li>
        <li>{t("about.why.health.stroke")}</li>
      </ul>
      <Typography variant="p">{t("about.why.p3")}</Typography>
    </div>
    <div
      class="md:mt-8 flex md:items-center md:justify-center w-screen md:w-auto max-h-80 md:max-h-svh"
    >
      <Image
        alt="Paraguay map with question mark on asuncion"
        loading="lazy"
        src={Map2Image}
        class="object-none md:object-cover"
      />
    </div>
  </section>
  <section
    class="grid md:grid-cols-3 md:px-16 gap-12 md:py-32 place-content-stretch place-items-center justify-center bg-light_green p-12"
  >
    <div class="space-y-4 justify-stretch mt-12 md:m-0 md:col-span-2">
      <Image src={Github} alt="Github logo" />
      <h3
        class={`font-sans font-semibold text-[1.2rem] md:text-[1.875rem] text-black`}
      >
        {t("about.openSource.line1")}
      </h3>
      <h3
        class={`font-sans font-semibold text-[1.2rem] md:text-[1.875rem] text-black`}
      >
        {t("about.openSource.line2")}
      </h3>
      <Button
        variant="color"
        text={t("about.openSource.cta")}
        onclick=`window.open("${GITHUB_URL}","_blank","","")`
        customClass="max-w-64"
      />
    </div>
    <div class="md:mt-8 flex md:items-center md:justify-center">
      <Image src={GithubIcon} alt="Invertocat logo" />
    </div>
  </section>
  <section class="flex flex-col py-8 px-8 md:px-16">
    <Typography variant="h2" customClass="pt-2"
      >{t("about.collaborators")}</Typography
    >
    <div
      class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-5 gap-6 place-content-start py-8"
    >
      {
        TEAM.map((team) => (
          <div class="drop-shadow-md flex flex-col w-full h-full overflow-hidden rounded-md">
            <div class="bg-lightgray w-full h-72 overflow-hidden rounded-t-md">
              <Picture
                src={team.image.path}
                alt={team.name}
                class={`object-cover h-full w-full ${team.imageClass ?? ""}`}
                widths={[240, 540, 720, team.image.path.width]}
                sizes={`(max-width: 360px) 240px, (max-width: 720px) 400px, (max-width: 1600px) 600px, ${team.image.path.width}px`}
              />
            </div>
            <div class="bg-white w-full min-h-[5rem] rounded-b-md p-3">
              <Typography variant="h6">{team.name}</Typography>
              <Typography variant="p-sm">{team.title}</Typography>
            </div>
          </div>
        ))
      }
    </div>
  </section>
  <section class="flex flex-col py-8 px-8 md:px-16">
    <Typography variant="h2" customClass="pt-2"
      >{t("about.organizations")}</Typography
    >
    <div
      class="grid md:divide-x text-black md:grid-cols-4 sm:grid-cols-1 mt-12 md:py-12 md:max-w-fit w-full md:items-center"
    >
      {
        ORGANIZATIONS.map((org) => (
          <div class="first:pl-0 md:last:pl-8 md:even:col-span-2 md:first:justify-start justify-center flex w-full md:mx-10 md:my-0 my-6">
            <Image alt={org.alt} src={org.path} class={org.class} />
          </div>
        ))
      }
    </div>
  </section>
  <BackTop />
  <Footer />
</BaseLayout>
