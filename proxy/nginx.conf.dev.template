worker_processes 8;
user root;
error_log  /var/log/nginx/error.log;
pid /var/run/nginx.pid;

events {}

http {
    include mime.types;
    server_tokens off;
    client_max_body_size 10m;
    client_header_timeout 15s;
    client_body_timeout 15s;
    send_timeout 30s;
    keepalive_timeout 30s;
    reset_timedout_connection on;

    limit_req_zone $binary_remote_addr zone=admin_login_rate:10m rate=5r/m;
    limit_conn_zone $binary_remote_addr zone=perip_conn:10m;

    server {
        listen 80;
        server_name $SERVER_HOST;

        location /static/ {
            alias /static/;
            autoindex off;
            access_log off;
        }

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }
        return 301 https://$SERVER_HOST$request_uri;

    }
    server {
        listen 443 default_server ssl ;
        listen [::]:443 ssl;
        http2 on;

        server_name $SERVER_HOST;

        ssl_certificate /etc/nginx/ssl/live/$CERT_NAME/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/live/$CERT_NAME/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;
        ssl_session_tickets off;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

        location /static/ {
            alias /static/;
            autoindex off;
            access_log off;
        }

        location /api/ {
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 10s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            proxy_pass http://$BACKEND_HOST:$BACKEND_PORT;
        }

        location = /admin {
            return 301 /admin/;
        }

        location = /admin/login/ {
            include /etc/nginx/conf.d/admin-ip-allowlist.conf;
            limit_req zone=admin_login_rate burst=10 nodelay;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 10s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            proxy_pass http://$BACKEND_HOST:$BACKEND_PORT;
        }

        location /admin/ {
            include /etc/nginx/conf.d/admin-ip-allowlist.conf;
            limit_conn perip_conn 20;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 10s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            proxy_pass http://$BACKEND_HOST:$BACKEND_PORT;
        }

        location / {
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 10s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            proxy_pass http://$FRONTEND_HOST:$FRONTEND_PORT;
        }
    }
}
