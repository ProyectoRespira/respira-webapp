# =============================================================================
# PROXY — Upstream Services
# Copy this file to proxy/.env and fill in the values.
# When running via docker-compose these are injected from the root .env.
# =============================================================================

# Hostname of the backend service as seen from the proxy container.
BACKEND_HOST=localhost

# Port the backend service listens on.
BACKEND_PORT=8000

# Hostname of the frontend service as seen from the proxy container.
FRONTEND_HOST=localhost

# Port the frontend service listens on.
FRONTEND_PORT=4321

# =============================================================================
# PROXY — Server Identity
# =============================================================================

# Public hostname used in server_name directives and HTTP→HTTPS redirects.
SERVER_HOST=localhost

# Comma-separated IP/CIDR ranges allowed to access Django Admin (/admin/).
# Examples:
# PROXY_ADMIN_ALLOWED_IP_RANGES=127.0.0.1/32
# PROXY_ADMIN_ALLOWED_IP_RANGES=203.0.113.10/32,198.51.100.0/24
# If empty, /admin/ access is denied by default.
PROXY_ADMIN_ALLOWED_IP_RANGES=127.0.0.1/32

# Report-only CSP is the safe rollout mode. Set `off` for an emergency rollback.
# The GlitchTip endpoint/origin are optional public frontend-project values.
PROXY_CSP_MODE=report-only
PROXY_CSP_SECURITY_ENDPOINT=
PROXY_CSP_GLITCHTIP_ORIGIN=

# =============================================================================
# PROXY — TLS (required for production and development targets)
# Not needed for the local target (plain HTTP only).
# =============================================================================

# Directory name under /etc/nginx/ssl/live/ where the certificate files live.
# CERT_NAME=example.com
