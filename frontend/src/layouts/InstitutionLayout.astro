---
// Shell for the private institutional area (RES-328).
//
// Deliberately not `BaseLayout`: that one mounts the public Navbar, the share
// and alert modals and the Facebook SDK, none of which belong in a client's
// private panel. Keeping the two shells separate is also what guarantees this
// feature cannot change the public dashboard.
//
// The panel draws its own chrome — the sidebar with the institution, the menu
// and the logout (#338) — so this shell is only the document around it. No
// language selector on purpose: the panel inherits whatever language the
// visitor was reading the public site in (the site-wide `respira-lang`
// cookie).

import "@fontsource-variable/open-sans";
import "@fontsource/merriweather/400.css";
import "@fontsource/merriweather/700.css";
import "@fontsource/merriweather/900.css";

import "../../main.css";

import { getLangFromLocals } from "../i18n/utils";

interface Props {
  title: string;
}

const { title } = Astro.props;
const lang = getLangFromLocals(Astro.locals);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- A client's private panel has no business in a search index. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Respira</title>
  </head>

  <body class="min-h-screen bg-[#F1ECE9] font-sans text-[#1B1B1A]">
    <slot />
  </body>
</html>
