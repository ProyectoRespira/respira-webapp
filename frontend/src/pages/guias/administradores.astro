---
// User Guide — administrators.
//
// Adapted from the Product artifact "Alta de una institución en Respira — Guía
// QA" (f8e2cefe-462b-4665-8622-477241f1af09). Static markup, no CMS.
//
// The source is a QA runbook; this is a user guide, and the difference is what
// drove the departures from it:
//
//   * the closing checklist, the endpoint reference table and the Swagger
//     walkthrough are gone. They verify the API, which is a developer's job,
//     not the job of somebody registering an institution — the verification
//     step here goes through the panel's own screen instead;
//   * "Errores comunes" is written in terms of what the administrator sees
//     ("el usuario no puede entrar") rather than HTTP status codes;
//   * source-file references ("backend/api/models.py:147-168") are dropped —
//     useful to a reviewer reading the repo, not to somebody following steps,
//     and this page is served publicly;
//   * the guide's Part 2 no longer says the institutional panel has no login
//     screen of its own. It has one, so that is what the verification uses;
//   * password recovery is added, since administrators now have one.
//
// Everything that is an instruction — the steps, the field lists, the gotchas —
// is carried over. Screenshots are captures of the running admin against seeded
// sample data; see the note in `instituciones.astro` for how to refresh them,
// and pin `prefers-color-scheme: light` so the admin does not come out dark.
//
// Trilingual, like the guide it sits next to: the prose lives in
// `i18n/guides.ts`. Admin field names, menu paths and management commands stay
// untranslated on purpose — they are what the reader sees on screen and types
// into a terminal, and translating them would send people looking for controls
// that do not exist.

import { Image } from "astro:assets";

import GuideLayout from "../../layouts/GuideLayout.astro";
import Callout from "../../components/guides/Callout.astro";
import AdminHome from "../../assets/guias/admin-inicio.png";
import AdminInstitution from "../../assets/guias/admin-institucion.png";
import AdminContract from "../../assets/guias/admin-contrato.png";
import { GUIDE_ROUTES, INSTITUTION_ACCESS } from "../../data/menu";
import { useGuideCopy } from "../../i18n/guides";
import { getLangFromLocals } from "../../i18n/utils";
import { getSiteUrl } from "../../store/runtime-config";

const lang = getLangFromLocals(Astro.locals);
const c = useGuideCopy(lang);

// The real admin address for whatever environment is serving this page, rather
// than a `https://<host>/admin/` placeholder the reader has to fill in
// themselves. `getSiteUrl` is what the navbar already uses, so the guide and
// the site agree on the origin; the fallback keeps the link relative if the
// runtime config is ever unreadable, which still resolves correctly in a
// browser.
let adminUrl = "/admin/";
let adminLoginUrl = "/admin/login/";
try {
  const siteUrl = await getSiteUrl();
  adminUrl = new URL("/admin/", siteUrl).href;
  adminLoginUrl = new URL("/admin/login/", siteUrl).href;
} catch (error) {
  console.error("Could not resolve the site URL for the admin links", error);
}

// Unnumbered, like the institutions guide. Numbering only fit six of these
// eight: "Recuperar tu contraseña" and "Si algo no sale bien" are not steps in
// the sequence, which is what left the sidebar half-numbered. The order of the
// procedure is carried by the document order and by the prose, which
// cross-references sections by name rather than by number.
const sections = [
  { id: "admin", label: c.adminNavAdmin },
  { id: "institucion", label: c.adminNavInstitucion },
  { id: "usuario", label: c.adminNavUsuario },
  { id: "alertas", label: c.adminNavAlertas },
  { id: "estacion", label: c.adminNavEstacion },
  { id: "verificar", label: c.adminNavVerificar },
  { id: "clave", label: c.adminNavClave },
  { id: "errores", label: c.adminNavErrores },
];

// Shared by the three admin captures: the same shell at the same width, so they
// read as one sequence rather than three unrelated pictures.
const shotClass = "h-auto w-full rounded-xl border border-bg-gray";
const shotSizes = "(min-width: 1024px) 700px, 100vw";
const shotWidths = [640, 960, 1280];
---

<GuideLayout
  eyebrow={c.adminEyebrow}
  title={c.adminTitle}
  dek={c.adminDek}
  meta={[c.adminMeta1, c.adminMeta2]}
  sections={sections}
>
  <section id="admin">
    <h2>{c.adminAdminTitle}</h2>
    <p class="lede">
      {c.adminAdminLede1}
      <strong>{c.adminAdminLedeAdmin}</strong>{" "}
      {c.adminAdminLede2}
      <strong>{c.adminAdminLedePanel}</strong>{c.adminAdminLede3}
      <a href={GUIDE_ROUTES.institution}>{c.adminAdminLedeLink}</a>{
        c.adminAdminLede4
      }
    </p>

    <ol class="steps">
      <li>
        {c.adminAdminStep1}
        <a class="admin-link" href={adminUrl}>{adminUrl}</a>
      </li>
      <li>
        {c.adminAdminStep2a}
        <strong>{c.adminAdminStep2Email}</strong>{" "}
        {c.adminAdminStep2And}
        <strong>{c.adminAdminStep2Password}</strong>{c.adminAdminStep2b}
      </li>
      <li>
        {c.adminAdminStep3a}
        <span class="path">Accounts</span>{" "}
        {c.adminAdminStep3b}
        <span class="path">Api</span>{c.adminAdminStep3c}
      </li>
    </ol>

    <figure class="my-6">
      <Image
        src={AdminHome}
        alt={c.adminHomeAlt}
        widths={shotWidths}
        sizes={shotSizes}
        loading="lazy"
        class={shotClass}
      />
      <figcaption>
        {c.adminHomeCaption1}
        <span class="path">Api</span>{c.adminHomeCaption2}
      </figcaption>
    </figure>

    <p>{c.adminNoAccount}</p>
    <ul>
      <li>
        {c.adminSuperuser1}
        <strong>{c.adminSuperuserWord}</strong>{" "}
        {c.adminSuperuser2}
        <code>python manage.py createsuperuser</code>{c.adminSuperuser3}
        <code>python manage.py bootstrap_superuser</code>
        {c.adminSuperuser4}{" "}
        <code>BACKEND_SUPERUSER_EMAIL</code> /
        <code>BACKEND_SUPERUSER_PASSWORD</code>{c.adminSuperuser5}
      </li>
      <li>
        {c.adminRole1}
        <code>admin</code>
        {c.adminRoleOr}
        <code>editor</code>{" "}
        {c.adminRole2}
        <code>python manage.py sync_roles</code>
        {c.adminRole3}
      </li>
    </ul>

    <Callout label={c.adminAdminCalloutLabel} tone="warn">
      <p>
        {c.adminAdminCallout1}
        <code>role</code>
        {c.adminAdminCallout2}
        <span class="path">Accounts → Users</span>
        {c.adminAdminCallout3}
        <code>sync_roles</code>
        {c.adminAdminCallout4}
      </p>
    </Callout>
  </section>

  <section id="institucion">
    <h2>{c.adminInstTitle}</h2>
    <p class="lede">{c.adminInstLede}</p>

    <span class="menu-path"
      >Admin<span class="sep">→</span>Api<span class="sep">→</span
      >Institutions<span class="sep">→</span>Add institution</span
    >

    <figure class="my-6">
      <Image
        src={AdminInstitution}
        alt={c.adminInstAlt}
        widths={shotWidths}
        sizes={shotSizes}
        loading="lazy"
        class={shotClass}
      />
      <figcaption>{c.adminInstCaption}</figcaption>
    </figure>

    <dl class="fields">
      <dt>legal_name</dt>
      <dd>
        <span class="req">{c.adminRequired}</span>
        {c.adminFieldLegalName}
      </dd>
      <dt>display_name</dt>
      <dd>{c.adminFieldDisplayName}</dd>
      <dt>institution_type</dt>
      <dd>{c.adminFieldType}</dd>
      <dt>contact_name / contact_email / contact_phone</dt>
      <dd>{c.adminFieldContact}</dd>
      <dt>address / city</dt>
      <dd>{c.adminFieldLocation}</dd>
      <dt>notes</dt>
      <dd>{c.adminFieldNotes}</dd>
    </dl>

    <p>
      {c.adminInstAfter1}
      <code>legal_name</code>
      {c.adminInstAfter2}
      <strong>{c.adminInstAfterSame}</strong>.
    </p>
  </section>

  <section id="usuario">
    <h2>{c.adminUserTitle}</h2>
    <p class="lede">{c.adminUserLede}</p>

    <ul>
      <li>
        {c.adminUserStep1a}
        <strong>"Dashboard users"</strong>.
      </li>
      <li>
        {c.adminUserStep2a}
        <code>User</code>
        {c.adminUserStep2b}
        <span class="path">Admin → Accounts → Users</span>
        {c.adminUserStep2c}
      </li>
      <li>{c.adminUserStep3}</li>
    </ul>

    <Callout label={c.adminUserCalloutLabel}>
      <p>
        {c.adminUserCallout1}
        <strong>{c.adminUserCalloutBold}</strong>{c.adminUserCallout2}
        <strong>{c.adminUserCalloutSave}</strong>
        {c.adminUserCallout3}
      </p>
    </Callout>
  </section>

  <section id="alertas">
    <h2>{c.adminAlertsTitle}</h2>
    <p class="lede">{c.adminAlertsLede}</p>
    <p>
      {c.adminAlertsBody1}
      <strong>"Institution alert config"</strong>{c.adminAlertsBody2}
    </p>
  </section>

  <section id="estacion">
    <h2>{c.adminStationTitle}</h2>
    <p class="lede">{c.adminStationLede}</p>

    <span class="menu-path"
      >Admin<span class="sep">→</span>Api<span class="sep">→</span>Institution
      contracts<span class="sep">→</span>Add</span
    >

    <figure class="my-6">
      <Image
        src={AdminContract}
        alt={c.adminContractAlt}
        widths={shotWidths}
        sizes={shotSizes}
        loading="lazy"
        class={shotClass}
      />
      <figcaption>{c.adminContractCaption}</figcaption>
    </figure>

    <dl class="fields">
      <dt>institution</dt>
      <dd>
        <span class="req">{c.adminRequired}</span>
        {c.adminFieldInstitution}
      </dd>
      <dt>station</dt>
      <dd>
        <span class="req">{c.adminRequired}</span>
        {c.adminFieldStation}
        <code>station_code</code>.
      </dd>
      <dt>contract_status</dt>
      <dd>{c.adminFieldContractStatus}</dd>
      <dt>start_date</dt>
      <dd><span class="req">{c.adminRequired}</span></dd>
      <dt>end_date / monthly_fee / signed_contract_url</dt>
      <dd>{c.adminFieldOptional}</dd>
    </dl>

    <Callout label={c.adminStationCalloutLabel} tone="warn">
      <p>
        {c.adminStationCallout1}
        <strong>{c.adminStationCalloutBold}</strong>{c.adminStationCallout2}
      </p>
    </Callout>

    <p>
      {c.adminStationCode1}
      <code>station_code</code>
      {c.adminStationCode2}
    </p>
  </section>

  <section id="verificar">
    <h2>{c.adminVerifyTitle}</h2>
    <p class="lede">{c.adminVerifyLede}</p>

    <ol class="steps">
      <li>
        {c.adminVerifyStep1a}
        <a href={INSTITUTION_ACCESS.route}>{INSTITUTION_ACCESS.title}</a>
        {c.adminVerifyStep1b}
        <span class="path">{INSTITUTION_ACCESS.route}</span>.
      </li>
      <li>
        {c.adminVerifyStep2a}
        <strong>{c.adminVerifyStep2Bold}</strong>{" "}
        {c.adminVerifyStep2b}
      </li>
      <li>{c.adminVerifyStep3}</li>
    </ol>

    <p>
      {c.adminVerifyAfter1}
      <a href={GUIDE_ROUTES.institution}>{c.adminAdminLedeLink}</a>{
        c.adminVerifyAfter2
      }
    </p>
  </section>

  <section id="clave">
    <h2>{c.adminClaveTitle}</h2>
    <p class="lede">{c.adminClaveLede}</p>
    <ol class="steps">
      <li>
        {c.adminClaveStep1a}
        <a class="path" href={adminLoginUrl}>/admin/login/</a>{
          c.adminClaveStep1b
        }
        <strong>{c.adminClaveStep1Bold}</strong>{c.adminClaveStep1c}
      </li>
      <li>{c.adminClaveStep2}</li>
      <li>{c.adminClaveStep3}</li>
      <li>
        {c.adminClaveStep4a}
        <a class="path" href={adminLoginUrl}>/admin/login/</a>
        {c.adminClaveStep4b}
      </li>
    </ol>

    <Callout label={c.adminClaveCalloutLabel} tone="warn">
      <p>{c.adminClaveCallout1}</p>
      <p>
        {c.adminClaveCallout2a}
        <span class="path">/admin/</span>{c.adminClaveCallout2b}
      </p>
    </Callout>

    <p>
      {c.adminClaveAfter1}
      <a href={GUIDE_ROUTES.institution}>{c.adminAdminLedeLink}</a>{
        c.adminClaveAfter2
      }
    </p>
  </section>

  <section id="errores">
    <h2>{c.adminErroresTitle}</h2>

    <Callout label={c.adminError1Label} tone="danger">
      <p>
        {c.adminError1a}
        <a href="#usuario">{c.adminError1Link}</a>{" "}
        {c.adminError1b}
        <span class="path">/admin/</span>
        {c.adminError1c}
      </p>
    </Callout>

    <Callout label={c.adminError2Label} tone="danger">
      <p>
        {c.adminError2a}
        <a href="#estacion">{c.adminError2Link}</a>.
      </p>
    </Callout>

    <Callout label={c.adminError3Label} tone="warn">
      <p>{c.adminError3}</p>
    </Callout>

    <Callout label={c.adminError4Label}>
      <p>{c.adminError4}</p>
    </Callout>
  </section>
</GuideLayout>
