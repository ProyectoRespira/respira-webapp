# Optional overrides for respira-sensor-alerts.service
# Copy to /etc/default/respira-sensor-alerts

# Compose project path on the host
RESPIRA_COMPOSE_PATH=/workspaces/respira-webapp

# Extra arguments for the management command.
#
# Delivery itself is gated by BACKEND_SENSOR_ALERTS_ENABLED in the compose
# `.env`, not here — that is the switch that decides whether real devices get
# notified, and it belongs with the rest of the backend configuration.
#
# Use `--dry-run` to have the timer report what it would send without sending
# it, which is the safe way to watch a new environment for a day first.
# RESPIRA_SENSOR_ALERTS_ARGS=--dry-run
