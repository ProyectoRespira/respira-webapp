---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/atoms/Footer.astro";
import BackTop from "../components/atoms/BackTop.astro";
import TwitterCard from "../components/cards/TwitterCard.astro";
import TelegramCard from "../components/cards/TelegramCard.astro";
import Typography from "../components/atoms/Typography.astro";
import Button from "../components/atoms/Button.astro";
import { getLangFromLocals, useTranslations } from "../i18n/utils";

const t = useTranslations(getLangFromLocals(Astro.locals));
---

<script>
  import { actions } from "astro:actions";

  const form = document.querySelector<HTMLFormElement>("form");
  const submitBtn = document.querySelector<HTMLButtonElement>("#form-button");
  const successMsg = document.querySelector<HTMLElement>("#form-success");
  const errorMsg = document.querySelector<HTMLElement>("#form-error");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (submitBtn) submitBtn.disabled = true;
    successMsg?.classList.add("hidden");
    errorMsg?.classList.add("hidden");

    const formData = new FormData(form);
    const { error } = await actions.sendMail(formData);

    if (error) {
      window.alert(form.dataset.errorMsg ?? "Error");
      return console.error({ error });
    }
    window.alert(form.dataset.successMsg ?? "Sent");
    console.log({ data });
  });
</script>

<BaseLayout>
  <section class="flex flex-col md:flex-row px-16 p-20">
    <div class="md:w-1/2">
      <Typography variant="h2">{t("contact.title")}</Typography>
      <Typography variant="p">{t("contact.subtitle")}</Typography>
      <div class="md:mr-8 gap-2 flex flex-col my-8">
        <form
          class="md:mr-8 gap-2 flex flex-col my-8"
          id="contacto"
          data-error-msg={t("contact.errorAlert")}
          data-success-msg={t("contact.successAlert")}
        >
          <div class="mb-4 flex flex-col md:flex-row gap-4">
            <div class="w-full">
              <label
                class="block text-gray-700 text-sm font-bold mb-2"
                for="name"
              >
                {t("contact.name")}*
              </label>
              <input
                class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"
                id="name"
                name="name"
                type="text"
                placeholder={t("contact.namePlaceholder")}
                required
              />
            </div>
            <div class="w-full">
              <label
                class="block text-gray-700 text-sm font-bold mb-2"
                for="lastname"
              >
                {t("contact.lastname")}
              </label>
              <input
                class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"
                id="lastname"
                type="text"
                name="lastname"
                placeholder={t("contact.lastnamePlaceholder")}
              />
            </div>
          </div>
          <label class="block text-gray-700 text-sm font-bold mb-2" for="email">
            {t("contact.email")}*
          </label>
          <input
            class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"
            id="email"
            type="email"
            name="email"
            placeholder={t("contact.emailPlaceholder")}
            required
          />
          <label
            class="block text-gray-700 text-sm font-bold mb-2"
            for="motive"
          >
            {t("contact.motive")}*
          </label>
          <div class="relative">
            <select
              class="block appearance-none w-full bg-gray-200 border border-gray-200 text-gray-700 py-3 px-4 pr-8 rounded leading-tight focus:outline-none focus:bg-white focus:border-gray-500"
              id="motive"
              required
              name="motive"
            >
              <option>{t("contact.motive.data")}</option>
              <option>{t("contact.motive.research")}</option>
              <option>{t("contact.motive.internship")}</option>
              <option>{t("contact.motive.highAqi")}</option>
              <option>{t("contact.motive.health")}</option>
            </select>
            <div
              class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700"
            >
              <svg
                class="fill-current h-4 w-4"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                ><path
                  d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"
                ></path></svg
              >
            </div>
          </div>
          <label
            class="block text-gray-700 text-sm font-bold mb-2"
            for="message"
          >
            {t("contact.message")}*
          </label>
          <textarea
            class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"
            id="message"
            placeholder={t("contact.messagePlaceholder")}
            required
            name="message"
            maxlength="800"
            rows="8"></textarea>
          <p class="text-[#FF18DA] text-xs">
            {t("contact.maxChars")}
          </p>
          <p
            id="form-success"
            class="hidden text-green-600 text-sm font-medium mt-2"
          >
            ¡Mensaje enviado! Nos pondremos en contacto pronto.
          </p>
          <p
            id="form-error"
            class="hidden text-red-600 text-sm font-medium mt-2"
          >
            Hubo un error al enviar el mensaje. Por favor intentá de nuevo.
          </p>
          <div class="w-full mt-4">
            <Button
              text={t("contact.submit")}
              variant="color"
              id={"form-button"}
            />
          </div>
        </form>
      </div>
    </div>
    <div class="grid grid-row-4 md:w-1/2 gap-4 mt-[1/2]">
      <div class="row-span-2 md:h-60"></div>
      <div class="row-span-1 rounded-lg overflow-clip">
        <TelegramCard />
      </div>
      <div class="row-span-1 rounded-lg overflow-clip">
        <TwitterCard />
      </div>
    </div>
  </section>
  <BackTop />
  <Footer />
</BaseLayout>
