---
// Step one of password recovery: ask for the account's email.
//
// Public by design — a visitor who has lost their password has no session to
// check, so there is no guard here. The form itself is a React island because
// the whole interaction (submit, error, "check your inbox") happens without a
// page change.

import InstitutionAuthLayout from "../../layouts/InstitutionAuthLayout.astro";
import { ForgotPasswordForm } from "../../components/react/institution/ForgotPasswordForm";
import { useInstitutionCopy } from "../../i18n/institution";
import { getLangFromLocals } from "../../i18n/utils";

const lang = getLangFromLocals(Astro.locals);
const copy = useInstitutionCopy(lang);
---

<InstitutionAuthLayout
  title={copy.forgotTitle}
  tagline={copy.forgotTagline}
  blurb={copy.forgotBlurb}
>
  <ForgotPasswordForm lang={lang} client:load />
</InstitutionAuthLayout>
