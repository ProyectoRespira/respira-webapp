---
import { Image } from "astro:assets";
import Typography from "./atoms/Typography.astro";
import Heart from "../assets/icons/heart_icon.svg";
import Lung from "../assets/icons/lung_icon.svg";
import Flower from "../assets/icons/flower_icon.svg";
import Medicine from "../assets/icons/medicine_icon.svg";
import { getLangFromLocals, useTranslations } from "../i18n/utils";

const t = useTranslations(getLangFromLocals(Astro.locals));

const topIcons = [
  { src: Heart, alt: "" },
  { src: Lung, alt: "" },
  { src: Flower, alt: "" },
  { src: Medicine, alt: "" },
];

const joinUrl = "/unete";

const points = [
  { text: t("home.cta.point1"), icon: "people" },
  { text: t("home.cta.point2"), icon: "chart" },
  { text: t("home.cta.point3"), icon: "pin" },
];

const GLYPHS: Record<string, string> = {
  people:
    "M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3Zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5Z",
  chart:
    "M4 13c-1.1 0-2 .9-2 2v4c0 1.1.9 2 2 2s2-.9 2-2v-4c0-1.1-.9-2-2-2Zm8-9c-1.1 0-2 .9-2 2v13c0 1.1.9 2 2 2s2-.9 2-2V6c0-1.1-.9-2-2-2Zm8 5c-1.1 0-2 .9-2 2v9c0 1.1.9 2 2 2s2-.9 2-2v-9c0-1.1-.9-2-2-2Z",
  pin: "M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z",
  leaf: "M6.05 8.05c-2.73 2.73-2.73 7.15-.02 9.88 1.47-3.4 4.09-6.24 7.36-7.93-2.77 2.34-4.71 5.61-5.39 9.32 2.6 1.23 5.8.78 7.95-1.37C19.43 14.47 20 4 20 4S9.53 4.57 6.05 8.05Z",
};
---

<section
  class="flex flex-col md:pr-10 mt-8 md:mt-0"
  aria-labelledby="join-cta-title"
>
  <div
    class="grid w-full max-w-[39rem] grid-cols-4 items-center gap-6 md:gap-12 mb-9"
    aria-hidden="true"
  >
    {
      topIcons.map((icon) => (
        <Image
          class="h-12 w-12 md:h-14 md:w-14 object-contain"
          alt={icon.alt}
          src={icon.src}
          loading="lazy"
        />
      ))
    }
  </div>

  <Typography
    variant="h1"
    customClass="max-w-[34rem] !text-[2.45rem] md:!text-[2.8rem] leading-tight mb-5"
  >
    <span id="join-cta-title">{t("home.cta.title")}</span>
  </Typography>

  <div class="max-w-[35rem] mb-7">
    <Typography variant="p" color="gray" customClass="leading-relaxed">
      {t("home.cta.subtitle")}
    </Typography>
  </div>

  <ul class="flex flex-col gap-3.5 max-w-[42rem] mb-6">
    {
      points.map((point) => (
        <li class="flex flex-row items-start gap-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-light_green/50">
            <svg
              class="h-6 w-6 text-green"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={GLYPHS[point.icon]} />
            </svg>
          </span>
          <span class="font-sans text-[1rem] text-black pt-2">
            {point.text}
          </span>
        </li>
      ))
    }
  </ul>

  <div class="flex flex-col items-start gap-4 mb-7">
    <a
      href={joinUrl}
      class="bg-green text-white font-sans font-bold py-4 px-6 rounded-md text-base text-center w-full sm:w-[25.5rem] hover:opacity-90 transition-opacity flex items-center justify-center gap-2"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d={GLYPHS.leaf}></path>
      </svg>
      {t("home.cta.button")}
    </a>
    <a
      href={joinUrl}
      class="font-sans font-bold text-green underline underline-offset-4 hover:opacity-80 transition-opacity w-full sm:w-[25.5rem] text-center"
    >
      {t("home.cta.learnMore")} →
    </a>
  </div>

  <a
    href={joinUrl}
    class="group flex w-full max-w-[42rem] flex-row items-center gap-4 rounded-lg border border-bg-gray bg-light_green/40 p-4 hover:bg-light_green/60 transition-colors"
  >
    <span
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-green/20"
    >
      <svg
        class="h-5 w-5 text-green"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M16 11c1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3 1.34 3 3 3Zm-8 0c1.66 0 3-1.34 3-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5Z"
        ></path>
      </svg>
    </span>
    <div class="flex-1">
      <p class="font-sans font-bold text-sm text-black">
        {t("home.cta.note.title")}
      </p>
      <p class="font-sans text-sm text-gray mt-1">
        {t("home.cta.note.subtitle")}
      </p>
    </div>
    <svg
      class="h-5 w-5 shrink-0 text-gray group-hover:translate-x-1 transition-transform"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m9 18 6-6-6-6"></path>
    </svg>
  </a>
</section>
